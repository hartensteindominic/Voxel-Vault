    "test:universal": "node scripts/smoke-test-universal.mjs",
    "test:rewards": "node scripts/test-rewards-engine.mjs",
    "test:media": "node scripts/test-media-gallery.mjs",
    "test:mobile": "node scripts/check-mobile-webgl.mjs",
    "test:collection": "node scripts/test-collection-experience.mjs",
    "test:commerce": "node scripts/test-commerce-hardening.mjs",
    "test:routes": "node scripts/test-route-integrity.mjs",
    "test:voxelflip-launch": "node scripts/test-voxelflip-launch-safety.mjs",
    "test:release": "npm run test:rewards && npm run test:universal && npm run test:media && npm run test:mobile && npm run test:collection && npm run test:commerce && npm run test:routes && npm run test:voxelflip-launch && npm run build",
