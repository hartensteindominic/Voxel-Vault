default_platform(:ios)

platform :ios do
  desc "Deprecated: use the GitHub App Store release workflows for Galactic Trust Business"
  lane :release do
    UI.user_error!(
      "This legacy lane is intentionally disabled because ephemeral CI certificate generation can exhaust Apple signing-certificate limits. " \
      "Use 'App Store Release (No Mac Required)' for App Store Connect API-key cloud signing, or 'App Store Release (No p8 Fallback)' with a persistent P12 and provisioning profile."
    )
  end
end
