# Public Base RPC fallback. Flashblocks pending-state reads use the separate preconfirmation endpoint below.
BASE_RPC_URL=https://mainnet.base.org
BASE_FLASHBLOCKS_RPC_URL=https://mainnet-preconf.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# x402 revenue receiver. Use a public receiving address only; never put a private key here.
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_BASE_QUOTE_PRICE_ATOMIC=1000
X402_OPTIMIZE_PRICE_ATOMIC=5000
X402_DECISION_PRICE_ATOMIC=10000
X402_AI_LICENSE_PRICE_ATOMIC=10000

# Optional AI licensing wallet override. Leave blank to use the reviewed VoxelFlip production owner wallet.
# Only NFTs currently owned by this wallet can be offered by /api/licenses/use.
AI_LICENSE_LICENSOR_WALLET=

# Coinbase CDP facilitator credentials. Configure these only in your private local/Vercel environment.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Existing Profit Engine executor, once reviewed/deployed.
BASE_ARB_EXECUTOR_ADDRESS=
NEXT_PUBLIC_BASE_ARB_EXECUTOR_ADDRESS=

# Base Liquidity Engine. Leave operator blank/zero to keep autonomous operation disabled.
BASE_LIQUIDITY_MANAGER_ADDRESS=
NEXT_PUBLIC_BASE_LIQUIDITY_MANAGER_ADDRESS=
LIQUIDITY_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
LIQUIDITY_OPERATOR_ADDRESS=
LIQUIDITY_MAX_WETH_PER_POSITION_WEI=20000000000000000
LIQUIDITY_MAX_USDC_PER_POSITION_ATOMIC=50000000
LIQUIDITY_MAX_WETH_ALLOCATED_WEI=50000000000000000
LIQUIDITY_MAX_USDC_ALLOCATED_ATOMIC=150000000
LIQUIDITY_MAX_ACTIVE_POSITIONS=2

# Mainnet deployment remains locked unless intentionally enabled for a reviewed deployment.
ALLOW_BASE_LIQUIDITY_DEPLOY=false

# Real-property regulated-launch evidence gates.
# These values are never sufficient to enable money movement by themselves: the code-level
# implementation-ready constants remain false until the actual provider integrations exist.
REAL_ESTATE_REGISTERED_INTERMEDIARY_ACTIVE=false
REAL_ESTATE_OFFERING_AUTHORIZED=false
REAL_ESTATE_SECURITIES_COUNSEL_APPROVED=false
REAL_ESTATE_TITLE_COUNSEL_APPROVED=false
REAL_ESTATE_ISSUER_ENTITY_VERIFIED=false
REAL_ESTATE_KYC_AML_CONFIGURED=false
REAL_ESTATE_ESCROW_SETTLEMENT_CONFIGURED=false
REAL_ESTATE_CUSTODY_RAILS_CONFIGURED=false
REAL_ESTATE_CAP_TABLE_TRANSFER_CONFIGURED=false
REAL_ESTATE_PROPERTY_ACCOUNTING_CONFIGURED=false
REAL_ESTATE_TAX_REPORTING_CONFIGURED=false
REAL_ESTATE_CONTRACTS_AUDITED=false
REAL_ESTATE_PRIVACY_SECURITY_APPROVED=false
REAL_ESTATE_INCIDENT_RESPONSE_APPROVED=false
REAL_ESTATE_PROVIDER_INTEGRATION_VERIFIED=false
REAL_ESTATE_LIVE_INVESTING_ENABLED=false
REAL_ESTATE_LIVE_AUTO_REINVESTMENT_ENABLED=false

# Selected regulated-provider integration. Populate only after a signed/approved integration.
REAL_ESTATE_INTERMEDIARY_PROVIDER=
REAL_ESTATE_INTERMEDIARY_ACCOUNT_ID=
REAL_ESTATE_ESCROW_PROVIDER=
REAL_ESTATE_TRANSFER_RECORD_PROVIDER=

# Optional Base Sepolia demo-property metadata. Do not put confidential documents or PII here.
PILOT_PROPERTY_ID=PILOT-0001
PILOT_LEGAL_ENTITY_REFERENCE=DEMO PROPERTY LLC - NOT A LIVE OFFERING
PILOT_DEED_REFERENCE=DEMO DEED RECORD - NOT VERIFIED
PILOT_LEGAL_AGREEMENT_REFERENCE=DEMO OPERATING AGREEMENT - NOT EXECUTED
PILOT_PROPERTY_METADATA_URI=https://www.voxelvault.io/real-estate
PILOT_PROPERTY_MAX_UNITS=100000

# Hardhat only. Never commit this value. Prefer the browser/MetaMask deployment flow where available.
DEPLOYER_PRIVATE_KEY=
