# Galactic Trust public/auth configuration
NEXT_PUBLIC_SITE_URL=https://www.voxelvault.io
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Galactic Trust owner allowlist
GALACTIC_TRUST_ADMIN_EMAILS=
GALACTIC_TRUST_ADMIN_USER_IDS=

# Increase pretend-money sandbox only. Never expose this key through NEXT_PUBLIC_*.
GALACTIC_INCREASE_SANDBOX_ENABLED=false
INCREASE_SANDBOX_API_KEY=
INCREASE_SANDBOX_ACCOUNT_ID=
INCREASE_SANDBOX_WEBHOOK_SECRET=

# Production banking remains hard-locked in code. These assertions default false
# and cannot enable live money without a reviewed implementation release.
GALACTIC_BANKING_PLATFORM=
GALACTIC_SPONSOR_BANK_LEGAL_NAME=
GALACTIC_SPONSOR_BANK_AGREEMENT_ACTIVE=false
GALACTIC_PROGRAM_COMPLIANCE_APPROVED=false
GALACTIC_KYC_CIP_AML_APPROVED=false
GALACTIC_ACCOUNT_DISCLOSURES_APPROVED=false
GALACTIC_REG_E_APPROVED=false
GALACTIC_MONEY_MOVEMENT_APPROVED=false
GALACTIC_CARD_PROGRAM_APPROVED=false
GALACTIC_LEDGER_RECONCILIATION_APPROVED=false
GALACTIC_DEPOSIT_INSURANCE_DISCLOSURE_APPROVED=false
GALACTIC_PRIVACY_SECURITY_APPROVED=false
GALACTIC_COMPLAINTS_DISPUTES_APPROVED=false
GALACTIC_INCIDENT_RESPONSE_APPROVED=false
GALACTIC_PROVIDER_PRODUCTION_ACCEPTED=false
GALACTIC_LIVE_BANKING_ENABLED=false
GALACTIC_LIVE_CRYPTO_ENABLED=false
